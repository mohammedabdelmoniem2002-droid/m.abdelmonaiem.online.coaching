# ===== Elite Coach — Railway / Local Environment Variables =====
# انسخ لـ .env محلياً أو أضفها في Railway → Variables

# ---------- المدرب (Creator) ----------
COACH_USERNAME=m.abdelmoniem
COACH_PASSWORD=30210120200932
COACH_PHONE=01284931730

# رقم واتساب لاستقبال طلبات الشراء (دولي بدون +)
