# مدة جلسة المدرب بالدقائق
SESSION_MINUTES=10

# ---------- يوزرات العملاء (Client Users) ----------
# طريقة 1 — JSON (موصى بها):
# CLIENT_USERS=[{"name":"أحمد","phone":"01012345678","pass":"1234","months":"3"},{"name":"سارة","phone":"01198765432","pass":"sara99","months":"1"}]

# طريقة 2 — CSV بسيط (اسم:تليفون:باسورد:شهور):
# CLIENT_USERS=أحمد:01012345678:1234:3,سارة:01198765432:sara99:1

# لو سيبتها فاضية هيتم زرع عميلين تجريبيين:
#   01000000001 / 1111
#   01000000002 / 2222

CLIENT_USERS=[{"name":"عميل تجريبي 1","phone":"01000000001","pass":"1111","months":"3"},{"name":"عميل تجريبي 2","phone":"01000000002","pass":"2222","months":"1"}]

# المنفذ (Railway يضبطه تلقائي)
PORT=3000
